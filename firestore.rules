rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // قواعد عامة للقراءة العامة لمحتوى الرابطة
    match /standings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /events/{eventId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /lineups/{lineupId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /news/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notifications/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /disciplinary_decisions/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /regulations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /referees_assignments/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /downloadable_forms/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /analytics/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // ── بوابة الاعتمادات الصحفية ────────────────────────────
    // السماح للصحفيين بتقديم طلب الاعتماد (create) والاستعلام عن طلباتهم (read)
    // وحصر التعديل والاعتماد والحذف على إدارة الرابطة المسجلة الدخول
    match /media_accreditations/{accreditationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // القاعدة الاحتياطية
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
